// File name: projects/1/Or8Way.hdl
/**
 * 8-way Or gate: 
 * out = in[0] Or in[1] Or ... Or in[7]
 */
CHIP Or8Way {
    IN in[8];
    OUT out;

    PARTS:
    Or(a=in[0], b=in[1], out=firstTwo);
    Or(a=firstTwo, b=in[2], out=firstThree);
    Or(a=firstThree, b=in[3], out=firstFour);
    Or(a=firstFour, b=in[4], out=firstFive);
    Or(a=firstFive, b=in[5], out=firstSix);
    Or(a=firstSix, b=in[6], out=firstSeven);
    Or(a=firstSeven, b=in[7], out=out);
}